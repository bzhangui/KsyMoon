///|
fn generate_context_schema(schema : Schema) -> String raise SchemaError {
  let output = StringBuilder()
  let id = schema.root.name
  let root = pascal_case(id)
  let records = [schema.root, ..schema.records]
  let graph = context_graph(schema)
  let effects = context_read_effects(schema)
  let flags = context_flags(schema)
  let expressions = context_all_expressions(schema)
  let decode = expressions.iter().any(context_contains_decode)
  if decode && !flags.contains("text") {
    flags.push("text")
  }
  let object_values = []
  let mut stream_values = false
  for owner, record in graph.records {
    stream_values = stream_values ||
      record.parameters.iter().any(fn(p) { parameter_is_stream(p.kind) })
    for instance in record.instances {
      if instance.kind is Value(expression) {
        match
          context_expression_type(
            context_scope(graph, owner, instance.name),
            expression,
          ) {
          Stream => stream_values = true
          Object(names) =>
            for name in names {
              if !object_values.contains(name) {
                object_values.push(name)
              }
            }
          Sequence(element) if parameter_is_object(element) =>
            graph.object_refs = true
          Sequence(element) if parameter_is_stream(element) =>
            stream_values = true
          _ => ()
        }
      }
    }
  }
  let mut numeric = false
  let mut wide = false
  let mut repeated = false
  let mut contents = false
  let mut validation = false
  let mut predicates = false
  let mut positions = false
  let mut reads = false
  let mut bounded = false
  let mut options = false
  let mut strings = false
  let mut single_byte_encoding = expressions
    .iter()
    .any(fn(expr) {
      expression_any(expr, fn(part) {
        part is Decode(_, "WINDOWS-1252" | "ISO-8859-1")
      })
    })
  let mut open_repeats = false
  for record in records {
    let fields = record.fields.copy()
    for instance in record.instances {
      if instance.kind is Parsed(field, position) {
        fields.push(field)
        positions = positions || position is Some(_)
      }
    }
    for field in fields {
      repeated = repeated || field.count is Some(_)
      open_repeats = open_repeats || field.count is Some(ToEnd)
      validation = validation || field.validation is Some(_)
      predicates = predicates || field.predicate is Some(_)
      for kind in walk_kinds(field.kind) {
        reads = reads ||
          (
            !(kind is Nested(_) || kind is Application(_, _)) &&
            !(kind is Switch(_, _, _, _) ||
            kind is Enumerated(_, _) ||
            kind is BitInteger(_, _) ||
            kind is WideBitInteger(_, _))
          )
        numeric = numeric ||
          kind is Unsigned(_, _) ||
          kind is Signed(_, _) ||
          kind is Float32(_)
        wide = wide || kind is (Unsigned64(_) | Signed64(_) | Float64(_))
        contents = contents || kind is Contents(_)
        bounded = bounded || kind is Bounded(_, _)
        strings = strings || kind is Text(_, _)
        single_byte_encoding = single_byte_encoding ||
          kind is Text(_, "WINDOWS-1252" | "ISO-8859-1")
        match kind {
          ByteField(bytes) | Text(bytes, _) | Bounded(_, bytes) =>
            options = options ||
              bytes.terminator is Some(_) ||
              bytes.padding is Some(_)
          _ => ()
        }
      }
    }
  }
  let has_instances = records
    .iter()
    .any(fn(record) { !record.instances.is_empty() })
  let has_parse_instances = records
    .iter()
    .any(fn(record) {
      record.instances
      .iter()
      .any(fn(instance) { instance.kind is Parsed(_, _) })
    })
  let accounting = repeated && has_parse_instances
  let rollback = accounting &&
    records
    .iter()
    .any(fn(record) {
      record.instances
      .iter()
      .any(fn(instance) {
        instance.kind is Parsed(field, position) &&
        context_instance_read_raises(field, position, effects)
      })
    })
  output.write_string("// Generated by KsyMoon from \{id}.ksy.\n\n")
  emit_enums(output, root, graph.enums)
  emit_switch_types(output, records, root)
  for index, record in records {
    context_emit_type(
      output,
      graph,
      if index == 0 {
        "@root"
      } else {
        record.name
      },
      record,
      root,
    )
  }
  emit_reader(
    output,
    root,
    has_bounded=bounded,
    has_byte_options=options,
    has_strings=strings || decode,
    single_byte_encoding~,
    has_open_repeats=open_repeats,
    has_numeric_fields=numeric,
    has_uint64=wide,
    has_repeated_fields=repeated,
    has_contents=contents,
    has_validation=validation,
    has_predicates=predicates,
    has_instances~,
    has_positions=positions,
    has_arithmetic=context_integer_helpers(graph),
    has_read_fields=reads,
    has_input=true,
    has_context=true,
    has_bits=graph.bits,
    has_narrow_bits=bit_fields(schema, wide=false),
    has_wide_bits=bit_fields(schema, wide=true),
  )
  emit_processors(output, root, flags)
  if stream_values {
    context_emit_stream_value(output, root, graph.bits)
  }
  if graph.object_refs {
    output.write_string(
      "///|\npub struct \{root}ObjectRef {\n  priv arena : \{root}Arena\n  priv context : Int\n}\n\n",
    )
  }
  context_emit_runtime(
    output,
    root,
    flags,
    rollback ||
    !graph.byte_orders.is_empty() ||
    records.iter().any(fn(record) { context_record_raises(record, effects) }),
    has_instances,
    accounting,
    rollback,
    graph.bits,
    schema.recursive,
    !graph.module_roots.is_empty() || graph.object_refs,
    !graph.byte_orders.is_empty(),
    expressions.iter().any(context_contains_index),
    !object_values.is_empty() || expressions.iter().any(context_contains_cast),
    !has_instances &&
    !expressions
    .iter()
    .any(fn(expr) {
      expression_any(expr, fn(part) {
        match part {
          Reference("_" | "_index" | "_io") | Member(_, "_in_enum") => false
          Reference(_) | Member(_, _) => true
          _ => false
        }
      })
    }),
  )
  emit_endian_inheritance(output, root, graph)
  for index, record in records {
    let owner = if index == 0 { "@root" } else { record.name }
    context_emit_reader(
      output,
      graph,
      owner,
      record,
      root,
      id,
      index,
      effects[owner],
      graph.byte_orders.contains(owner) ||
      context_record_raises(record, effects),
    )
    for instance in record.instances {
      context_emit_instance(
        output, graph, owner, record, instance, root, id, accounting, effects,
      )
    }
  }
  context_emit_dispatch(output, records, root, id)
  let hydrated = if graph.object_refs {
    graph.records.keys().collect()
  } else {
    context_hydrators(schema, object_values)
  }
  for name in hydrated {
    context_emit_hydrator(output, graph, name, root, graph.tags[name])
    if graph.object_refs {
      let accessor = if name == "@root" { "as_root" } else { "as_type_" + name }
      output.write_string(
        "///|\npub fn \{root}ObjectRef::\{accessor}(self : \{root}ObjectRef) -> \{context_type_name(root, name)} raise \{root}ParseError {\n  \{context_hydrate_name(root, name)}(self.arena, self.context, \{name.escape()})\n}\n\n",
      )
    }
  }
  context_emit_entry(
    output,
    schema.root,
    "@root",
    root,
    id,
    graph,
    effects,
    repeated,
    accounting,
  )
  for name in schema.argument_readers {
    context_emit_entry(
      output,
      graph.records[name],
      name,
      root,
      id,
      graph,
      effects,
      repeated,
      accounting,
    )
  }
  output.to_string()
}

///|
fn context_emit_entry(
  output : StringBuilder,
  record : RecordDef,
  owner : String,
  root : String,
  id : String,
  graph : ContextGraph,
  effects : Map[String, Bool],
  repeated : Bool,
  accounting : Bool,
) -> Unit {
  let object_parameters = record.parameters.filter(fn(p) {
    parameter_is_object(p.kind)
  })
  let effect = if effects[owner] || !object_parameters.is_empty() {
    " raise " + root + "ParseError"
  } else {
    ""
  }
  let budget = if repeated { ", budget: [1_000_000, 3, 0, 0]" } else { "" }
  let parameters = record.parameters
    .map(fn(p) {
      ", arg_" + p.name + " : " + parameter_result_type(p.kind, root)
    })
    .join("")
  let arguments = record.parameters
    .map(fn(p) { ", " + parameter_input(p.kind, "arg_" + p.name, root) })
    .join("")
  let accounts = if accounting { ", next_account: 1" } else { "" }
  let fresh_arena = "{ frames: [], free: []\{accounts} }"
  let (entry, reader, path) = if owner == "@root" {
    ("parse_" + id, "read_" + id + "_root", id)
  } else {
    (
      "parse_" + id + "_type_" + owner,
      nested_reader(id, owner),
      id + "." + owner,
    )
  }
  output.write_string(
    "///|\npub fn \{entry}(input : Bytes\{parameters}) -> \{context_type_name(root, owner)}\{effect} {\n",
  )
  if object_parameters.is_empty() {
    output.write_string("  let arena : \{root}Arena = \{fresh_arena}\n")
  } else {
    output.write_string("  let objects : Array[\{root}ObjectRef] = []\n")
    for p in object_parameters {
      let insert = if p.kind is Sequence(_) { "append" } else { "push" }
      output.write_string("  objects.\{insert}(arg_\{p.name})\n")
    }
    output.write_string(
      "  let arena : \{root}Arena = match objects.get(0) { Some(object) => object.arena; None => \{fresh_arena} }\n  guard objects.iter().all(fn(object) { physical_equal(object.arena, arena) }) else { raise \{root}ContextError(field=\{path.escape()}, offset=0, message=\"object arguments belong to different parses\") }\n",
    )
    for p in object_parameters {
      let sequence = p.kind is Sequence(_)
      let kind = if p.kind is Sequence(element) { element } else { p.kind }
      if kind is Object([name]) && name != "@any" {
        let tag = graph.tags[name]
        let field = (path + "." + p.name).escape()
        let values = if sequence {
          "arg_" + p.name
        } else {
          "[arg_" + p.name + "]"
        }
        output.write_string(
          "  for object in \{values} {\n    guard arena.frame(object.context, \{field}).tag == \{tag} else { raise \{root}ContextError(field=\{field}, offset=0, message=\"object argument has the wrong type\") }\n  }\n",
        )
      }
    }
  }
  output.write_string(
    "  let reader : \{root}Reader = { input, offset: 0\{budget}\{bit_state(graph.bits)} }\n  \{reader}(reader, \{path.escape()}, arena, -1\{arguments})\n}\n",
  )
}

///|
fn context_type_name(root : String, owner : String) -> String {
  if owner == "@root" {
    root + "Record"
  } else {
    nested_type(root, owner)
  }
}

///|
fn context_emit_type(
  output : StringBuilder,
  graph : ContextGraph,
  owner : String,
  record : RecordDef,
  root : String,
) -> Unit raise SchemaError {
  for instance in record.instances {
    if instance.kind is Value(expression) &&
      context_expression_type(
        context_scope(graph, owner, instance.name),
        expression,
      )
      is Object(names) &&
      names.length() > 1 {
      let kind = context_choice_type(root, owner, instance.name)
      output.write_string("///|\npub(all) enum \{kind} {\n")
      for index, name in names {
        output.write_string(
          "  Case\{index}(\{context_type_name(root, name)})\n",
        )
      }
      output.write_string("}\n\n")
    }
  }
  output.write_string("///|\npub struct \{context_type_name(root, owner)} {\n")
  for p in record.parameters {
    output.write_string(
      "  \{p.name} : \{parameter_result_type(p.kind, root)}\n",
    )
  }
  for field in record.fields {
    output.write_string(
      "  \{generated_member_name(field.name)} : \{field_result_type(field, root)}\n",
    )
  }
  if owner != "@root" ||
    graph.root_referenced ||
    !record.instances.is_empty() ||
    graph.object_refs {
    output.write_string("  priv _ksy_context : Int\n")
  }
  if !record.instances.is_empty() || graph.object_refs {
    output.write_string("  priv _ksy_arena : \{root}Arena\n")
    for instance in record.instances {
      output.write_string(
        "  priv mut _ksy_cache_\{instance.name} : \{context_instance_result(graph, owner, instance, root)}?\n",
      )
    }
  }
  output.write_string("}\n\n")
  if graph.object_refs {
    let name = context_type_name(root, owner)
    output.write_string(
      "///|\npub fn \{name}::_ksy_object_ref(self : \{name}) -> \{root}ObjectRef {\n  { arena: self._ksy_arena, context: self._ksy_context }\n}\n\n",
    )
  }
}

///|
fn context_emit_record_state(
  output : StringBuilder,
  graph : ContextGraph,
  owner : String,
  record : RecordDef,
) -> Unit {
  if owner != "@root" ||
    graph.root_referenced ||
    !record.instances.is_empty() ||
    graph.object_refs {
    output.write_string("    _ksy_context: context,\n")
  }
  if !record.instances.is_empty() || graph.object_refs {
    output.write_string("    _ksy_arena: arena,\n")
    for instance in record.instances {
      output.write_string("    _ksy_cache_\{instance.name}: None,\n")
    }
  }
}

///|
fn context_emit_reader(
  output : StringBuilder,
  graph : ContextGraph,
  owner : String,
  record : RecordDef,
  root : String,
  id : String,
  tag : Int32,
  raises : Bool,
  body_raises : Bool,
) -> Unit raise SchemaError {
  let name = if owner == "@root" {
    "read_" + id + "_root"
  } else {
    nested_reader(id, owner)
  }
  let effect = if raises { " raise " + root + "ParseError" } else { "" }
  let parameters = parameter_signature(record.parameters, root)
  let module_args = if graph.module_roots.is_empty() && !graph.object_refs {
    ""
  } else {
    let module_owner = graph.module_roots.get(owner).unwrap_or("@root")
    ", " + module_owner.escape() + ", " + (owner == module_owner).to_string()
  }
  output.write_string(
    "///|\nfn \{name}(reader : \{root}Reader, path : String, arena : \{root}Arena, parent : Int\{parameters}) -> \{context_type_name(root, owner)}\{effect} {\n  let context = arena.create(\{tag}, parent, reader, path\{module_args})\n",
  )
  if body_raises {
    output.write_string("  errdefer { arena.release(context) }\n")
  }
  for p in record.parameters {
    if p.range is Some((low, high)) {
      let field = "(path + \".\{p.name}\")"
      let message = context_error(
        root,
        field,
        message="parameter is outside its integer range",
      )
      let argument = "arg_" + p.name
      let condition = if p.kind is Sequence(_) {
        "\{argument}.iter().all(fn(item) { item >= \{low}L && item <= \{high}L })"
      } else {
        "\{argument} >= \{low}L && \{argument} <= \{high}L"
      }
      output.write_string("  guard \{condition} else { \{message} }\n")
    }
    output.write_string(
      "  arena.frames[context].unwrap().fields[\{p.name.escape()}] = \{parameter_pack(p.kind, "arg_" + p.name, root)}\n",
    )
  }
  select_byte_order(output, graph, owner, root)
  for field in record.fields {
    let name = field.name
    let path = "path_" + name
    output.write_string("  let \{path} = path + \".\{name}\"\n")
    let scope = context_scope(
      graph,
      owner,
      owner + "." + name,
      item=Some(field.kind),
      index_allowed=field.count is Some(_),
    )
    let evaluate = context_field_evaluator(scope, field, root, path)
    if field.condition is Some(expression) {
      output.write_string(
        "  let v_\{name} = if \{evaluate(expression, None)} {\n",
      )
    }
    let publish = if field.count is Some(_) {
      Some(
        (
          "  let metadata_" +
          name +
          " : Array[" +
          root +
          "Value] = []\n  arena.frames[context].unwrap().fields[" +
          name.escape() +
          "] = " +
          root +
          "Value::Items(metadata_" +
          name +
          ")\n",
          "    metadata_" +
          name +
          ".push(" +
          context_pack_kind(field.kind, "item", root) +
          ")\n",
        ),
      )
    } else {
      None
    }
    emit_field_read(
      output,
      field,
      "v_" + name,
      id,
      path,
      fn(name) { name },
      false,
      evaluate=Some(evaluate),
      parent_context=Some("context"),
      publish_items=publish,
      bits=graph.bits,
    )
    if field.condition is Some(_) {
      output.write_string("    Some(v_\{name})\n  } else { None }\n")
    }
    if field.count is None {
      output.write_string(
        "  arena.frames[context].unwrap().fields[\{name.escape()}] = \{context_pack_field(field, "v_" + name, root)}\n",
      )
    } else if field.condition is Some(_) {
      output.write_string(
        "  if v_\{name} is None { arena.frames[context].unwrap().fields[\{name.escape()}] = \{root}Value::Absent }\n",
      )
    }
  }
  output.write_string("  {\n")
  for p in record.parameters {
    output.write_string(
      "    \{p.name}: \{parameter_result(p.kind, "arg_" + p.name, root)},\n",
    )
  }
  for field in record.fields {
    output.write_string(
      "    \{generated_member_name(field.name)}: v_\{field.name},\n",
    )
  }
  context_emit_record_state(output, graph, owner, record)
  output.write_string("  }\n}\n\n")
}

///|
fn context_instance_name(id : String, owner : String, name : String) -> String {
  "instance_" +
  id +
  "_" +
  (if owner == "@root" { "root" } else { "type_" + owner }) +
  "_" +
  name
}

///|
fn context_emit_instance(
  output : StringBuilder,
  graph : ContextGraph,
  owner : String,
  _record : RecordDef,
  instance : Instance,
  root : String,
  id : String,
  repeated : Bool,
  effects : Map[String, Bool],
) -> Unit raise SchemaError {
  let name = instance.name
  let scope = context_scope(graph, owner, owner + ".instances." + name)
  output.write_string(
    "///|\nfn \{context_instance_name(id, owner, name)}(arena : \{root}Arena, context : Int) -> \{root}Value raise \{root}ParseError {\n  let frame = arena.frame(context, \{name.escape()})\n  let owner_reader = frame.reader\n  let field = frame.path + \".\{name}\"\n  guard !frame.busy.get(\{name.escape()}).unwrap_or(false) else { raise \{root}InstanceCycle(field~, offset=owner_reader.offset) }\n  frame.busy[\{name.escape()}] = true\n  defer { frame.busy[\{name.escape()}] = false }\n  let value = {\n",
  )
  if instance.condition is Some(condition) {
    output.write_string(
      "    if \{context_expression_code(scope, condition, root, "field", owner_reader="owner_reader")} {\n",
    )
  }
  match instance.kind {
    Value(expression) => {
      let code = context_value_code(
        scope, expression, root, "field", "owner_reader",
      )
      output.write_string("    \{code}\n")
    }
    Parsed(field, position) => {
      let read_raises = context_instance_read_raises(field, position, effects)
      let reader = match instance.io {
        Some(expression) =>
          context_expression_code(
            scope,
            expression,
            root,
            "field",
            owner_reader="owner_reader",
          )
        None => "owner_reader"
      }
      output.write_string("    let reader = \{reader}\n")
      if position is Some(_) {
        output.write_string(save_position("    ", graph.bits))
      }
      if repeated {
        output.write_string(
          "    let previous_account = reader.budget[1]\n    let account = reader.budget.length() + 1\n    reader.budget.push(arena.next_account)\n    arena.next_account += 1\n    reader.budget.push(0)\n    reader.budget[1] = account\n    defer { reader.budget[1] = previous_account; ignore(reader.budget.pop()); ignore(reader.budget.pop()) }\n",
        )
      }
      if repeated && read_raises {
        output.write_string(
          "    errdefer { reader.budget[0] += reader.budget[account]; arena.release_account(reader.budget[account - 1]) }\n",
        )
      }
      if position is Some(expression) {
        output.write_string(
          "    reader.seek(\{context_expression_code(scope, expression, root, "field", owner_reader="owner_reader")}, field)\n",
        )
      }
      let field_scope = context_scope(
        graph,
        owner,
        scope.path,
        item=Some(field.kind),
        index_allowed=field.count is Some(_),
      )
      let evaluate = context_field_evaluator(
        field_scope,
        field,
        root,
        "field",
        reader="owner_reader",
      )
      let publish = if field.count is Some(_) {
        Some(
          (
            "    let metadata_result : Array[" +
            root +
            "Value] = []\n    frame.partial[" +
            name.escape() +
            "] = " +
            root +
            "Value::Items(metadata_result)\n    defer { ignore(frame.partial.remove(" +
            name.escape() +
            ")) }\n",
            "    metadata_result.push(" +
            context_pack_kind(field.kind, "item", root) +
            ")\n",
          ),
        )
      } else {
        None
      }
      emit_field_read(
        output,
        field,
        "result",
        id,
        "field",
        fn(name) { name },
        true,
        evaluate=Some(evaluate),
        parent_context=Some("context"),
        publish_items=publish,
        bits=graph.bits,
      )
      if repeated {
        output.write_string(
          "    for index = 3; index < account; index = index + 2 {\n      if reader.budget[index - 1] == frame.account { reader.budget[index] += reader.budget[account]; break }\n    }\n",
        )
      }
      output.write_string("    \{context_pack_field(field, "result", root)}\n")
    }
  }
  if instance.condition is Some(_) {
    output.write_string("    } else { \{root}Value::Absent }\n")
  }
  output.write_string(
    "  }\n  frame.cache[\{name.escape()}] = value\n  value\n}\n\n",
  )
  let type_name = context_type_name(root, owner)
  let result_type = context_instance_result(graph, owner, instance, root)
  output.write_string(
    "///|\npub fn \{type_name}::\{generated_member_name(name)}(self : \{type_name}) -> \{result_type} raise \{root}ParseError {\n  if self._ksy_cache_\{name} is Some(value) { return value }\n  let arena = self._ksy_arena\n  let context = self._ksy_context\n  let frame = arena.frame(context, \{name.escape()})\n  let reader = frame.reader\n  let field = frame.path + \".\{name}\"\n  let raw = \{root}Value::ObjectId(context).attribute(arena, \{name.escape()}, field)\n",
  )
  let decode = match instance.kind {
    Parsed(field, _) => context_unpack_field(field, "value", root, "field")
    Value(expression) => context_decode_value(scope, expression, root, name)
  }
  let decode = if instance.condition is Some(_) {
    let option_names_in_enums = graph.enums
      .values()
      .any(fn(definition) {
        definition.labels
        .iter()
        .any(fn(label) { generated_enum_label(label.1) is ("None" | "Some") })
      })
    if option_names_in_enums {
      "(match raw { \{root}Value::Absent => Option::None; value => Option::Some(\{decode}) })"
    } else {
      "(match raw { \{root}Value::Absent => None; value => Some(\{decode}) })"
    }
  } else {
    "{ let value = raw; \{decode} }"
  }
  output.write_string(
    "  let result = \{decode}\n  self._ksy_cache_\{name} = Some(result)\n  result\n}\n\n",
  )
}

///|
fn context_emit_dispatch(
  output : StringBuilder,
  records : Array[RecordDef],
  root : String,
  id : String,
) -> Unit {
  output.write_string(
    "///|\nfn \{root}Arena::attribute(self : \{root}Arena, context : Int, name : String, field : String) -> \{root}Value raise \{root}ParseError {\n  let frame = self.frame(context, field)\n  if frame.fields.get(name) is Some(value) { return value }\n  if frame.cache.get(name) is Some(value) { return value }\n  if frame.partial.get(name) is Some(value) { return value }\n  match frame.tag {\n",
  )
  for index, record in records {
    if !record.instances.is_empty() {
      output.write_string("    \{index} => match name {\n")
      for instance in record.instances {
        let owner = if index == 0 { "@root" } else { record.name }
        output.write_string(
          "      \{instance.name.escape()} => \{context_instance_name(id, owner, instance.name)}(self, context)\n",
        )
      }
      output.write_string("      _ => \{root}Value::Absent\n    }\n")
    }
  }
  output.write_string("    _ => \{root}Value::Absent\n  }\n}\n\n")
}

///|
fn context_hydrators(
  schema : Schema,
  object_values : Array[String],
) -> Array[String] {
  let names = object_values.copy()
  for record in [schema.root, ..schema.records] {
    for instance in record.instances {
      if instance.kind is Parsed(field, _) {
        for name in kind_references(field.kind) {
          if !names.contains(name) {
            names.push(name)
          }
        }
      }
    }
  }
  let mut index = 0
  while index < names.length() {
    let record = if names[index] == "@root" {
      schema.root
    } else {
      schema.records
      .iter()
      .find_first(fn(record) { record.name == names[index] })
      .unwrap()
    }
    for field in record.fields {
      for name in kind_references(field.kind) {
        if !names.contains(name) {
          names.push(name)
        }
      }
    }
    index += 1
  }
  names
}

///|
fn context_emit_hydrator(
  output : StringBuilder,
  graph : ContextGraph,
  name : String,
  root : String,
  tag : Int32,
) -> Unit {
  let record = graph.records[name]
  output.write_string(
    "///|\nfn \{context_hydrate_name(root, name)}(arena : \{root}Arena, context : Int, path : String) -> \{context_type_name(root, name)} raise \{root}ParseError {\n  let frame = arena.frame(context, path)\n  guard frame.tag == \{tag} else { raise \{root}ContextError(field=path, offset=frame.reader.offset, message=\"record context type does not match\") }\n  {\n",
  )
  for p in record.parameters {
    let value = "frame.fields.get(" +
      p.name.escape() +
      ").unwrap_or(" +
      root +
      "Value::Absent)"
    let result = context_unpack_expression(
      p.kind,
      value,
      root,
      "path",
      "frame.reader",
    )
    output.write_string(
      "    \{p.name}: \{parameter_result(p.kind, result, root)},\n",
    )
  }
  for field in record.fields {
    output.write_string(
      "    \{generated_member_name(field.name)}: \{context_unpack_field(field, "frame.fields.get(" + field.name.escape() + ").unwrap_or(" + root + "Value::Absent)", root, "path", reader="frame.reader")},\n",
    )
  }
  context_emit_record_state(output, graph, name, record)
  output.write_string("  }\n}\n\n")
}
