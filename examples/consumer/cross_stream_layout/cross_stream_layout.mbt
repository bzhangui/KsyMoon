fn instance_cross_stream_layout_type_slot_parent_marker(arena : CrossStreamLayoutArena, context : Int) -> CrossStreamLayoutValue raise CrossStreamLayoutParseError {
  let frame = arena.frame(context, "parent_marker")
  let owner_reader = frame.reader
  let field = frame.path + ".parent_marker"
  guard !frame.busy.get("parent_marker").unwrap_or(false) else { raise CrossStreamLayoutInstanceCycle(field~, offset=owner_reader.offset) }
  frame.busy["parent_marker"] = true
  defer { frame.busy["parent_marker"] = false }
  let value = {
    let reader = (match CrossStreamLayoutValue::ObjectId(context).attribute(arena, "_parent", field).attribute(arena, "_io", field) { CrossStreamLayoutValue::Source(value) => value; _ => { raise CrossStreamLayoutContextError(field=field, offset=owner_reader.offset, message="value is unavailable or has the wrong type") } })
    let saved = reader.offset
    defer { reader.offset = saved }
    let previous_account = reader.budget[1]
    let account = reader.budget.length() + 1
    reader.budget.push(arena.next_account)
    arena.next_account += 1
    reader.budget.push(0)
    reader.budget[1] = account
    defer { reader.budget[1] = previous_account; ignore(reader.budget.pop()); ignore(reader.budget.pop()) }
    errdefer { reader.budget[0] += reader.budget[account]; arena.release_account(reader.budget[account - 1]) }
    reader.seek(0L, field)
  let result = reader.read_bits(1, false, field)
    for index = 3; index < account; index = index + 2 {
      if reader.budget[index - 1] == frame.account { reader.budget[index] += reader.budget[account]; break }
    }
    CrossStreamLayoutValue::Number(result.to_int64())
  }
  frame.cache["parent_marker"] = value
  value
}

///|
pub fn CrossStreamLayout_slot::parent_marker(self : CrossStreamLayout_slot) -> UInt raise CrossStreamLayoutParseError {
  if self._ksy_cache_parent_marker is Some(value) { return value }
  let arena = self._ksy_arena
  let context = self._ksy_context
  let frame = arena.frame(context, "parent_marker")
  let reader = frame.reader
  let field = frame.path + ".parent_marker"
  let raw = arena.attribute(context, "parent_marker", field)
  let result = { let value = raw; (match value { CrossStreamLayoutValue::Number(value) => value.to_int().reinterpret_as_uint(); _ => { raise CrossStreamLayoutContextError(field=field, offset=reader.offset, message="value is unavailable or has the wrong type") } }) }
  self._ksy_cache_parent_marker = Some(result)
  result
}

///|
fn read_cross_stream_layout_type_pair(reader : CrossStreamLayoutReader, path : String, arena : CrossStreamLayoutArena, parent : Int) -> CrossStreamLayout_pair raise CrossStreamLayoutParseError {
  let context = arena.create(2, parent, reader, path)
  errdefer { arena.release(context) }
  let path_first = path + ".first"
  let v_first = reader.read_bits(1, false, path_first)
  arena.frames[context].unwrap().fields["first"] = CrossStreamLayoutValue::Number(v_first.to_int64())
  let path_second = path + ".second"
  let v_second = reader.read_bits(1, false, path_second)
  arena.frames[context].unwrap().fields["second"] = CrossStreamLayoutValue::Number(v_second.to_int64())
  {
    first: v_first,
    second: v_second,
    _ksy_context: context,
    _ksy_arena: arena,
    _ksy_cache_parent_marker: None,
  }
}

///|
fn instance_cross_stream_layout_type_pair_parent_marker(arena : CrossStreamLayoutArena, context : Int) -> CrossStreamLayoutValue raise CrossStreamLayoutParseError {
  let frame = arena.frame(context, "parent_marker")
  let owner_reader = frame.reader
  let field = frame.path + ".parent_marker"
  guard !frame.busy.get("parent_marker").unwrap_or(false) else { raise CrossStreamLayoutInstanceCycle(field~, offset=owner_reader.offset) }
  frame.busy["parent_marker"] = true
  defer { frame.busy["parent_marker"] = false }
  let value = {
    let reader = (match CrossStreamLayoutValue::ObjectId(context).attribute(arena, "_parent", field).attribute(arena, "_io", field) { CrossStreamLayoutValue::Source(value) => value; _ => { raise CrossStreamLayoutContextError(field=field, offset=owner_reader.offset, message="value is unavailable or has the wrong type") } })
    let saved = reader.offset
    defer { reader.offset = saved }
    let previous_account = reader.budget[1]
    let account = reader.budget.length() + 1
    reader.budget.push(arena.next_account)
    arena.next_account += 1
    reader.budget.push(0)
    reader.budget[1] = account
    defer { reader.budget[1] = previous_account; ignore(reader.budget.pop()); ignore(reader.budget.pop()) }
    errdefer { reader.budget[0] += reader.budget[account]; arena.release_account(reader.budget[account - 1]) }
    reader.seek(0L, field)
  let result = reader.read_bits(1, false, field)
    for index = 3; index < account; index = index + 2 {
      if reader.budget[index - 1] == frame.account { reader.budget[index] += reader.budget[account]; break }
    }
    CrossStreamLayoutValue::Number(result.to_int64())
  }
  frame.cache["parent_marker"] = value
  value
}

///|
pub fn CrossStreamLayout_pair::parent_marker(self : CrossStreamLayout_pair) -> UInt raise CrossStreamLayoutParseError {
  if self._ksy_cache_parent_marker is Some(value) { return value }
  let arena = self._ksy_arena
  let context = self._ksy_context
  let frame = arena.frame(context, "parent_marker")
  let reader = frame.reader
  let field = frame.path + ".parent_marker"
  let raw = arena.attribute(context, "parent_marker", field)
  let result = { let value = raw; (match value { CrossStreamLayoutValue::Number(value) => value.to_int().reinterpret_as_uint(); _ => { raise CrossStreamLayoutContextError(field=field, offset=reader.offset, message="value is unavailable or has the wrong type") } }) }
  self._ksy_cache_parent_marker = Some(result)
  result
}

///|
fn CrossStreamLayoutArena::attribute(self : CrossStreamLayoutArena, context : Int, name : String, field : String) -> CrossStreamLayoutValue raise CrossStreamLayoutParseError {
  let frame = self.frame(context, field)
  if frame.fields.get(name) is Some(value) { return value }
  if frame.cache.get(name) is Some(value) { return value }
  if frame.partial.get(name) is Some(value) { return value }
  match frame.tag {
    0 => match name {
      "chosen" => instance_cross_stream_layout_root_chosen(self, context)
      "next_left" => instance_cross_stream_layout_root_next_left(self, context)
      "positioned" => instance_cross_stream_layout_root_positioned(self, context)
      "owner_position" => instance_cross_stream_layout_root_owner_position(self, context)
      "left_position" => instance_cross_stream_layout_root_left_position(self, context)
      "right_position" => instance_cross_stream_layout_root_right_position(self, context)
      "left_remaining" => instance_cross_stream_layout_root_left_remaining(self, context)
      "pair" => instance_cross_stream_layout_root_pair(self, context)
      "eos_items" => instance_cross_stream_layout_root_eos_items(self, context)
      "until_items" => instance_cross_stream_layout_root_until_items(self, context)
      "skipped" => instance_cross_stream_layout_root_skipped(self, context)
      "invalid" => instance_cross_stream_layout_root_invalid(self, context)
      "out_of_bounds" => instance_cross_stream_layout_root_out_of_bounds(self, context)
      "raw_switch" => instance_cross_stream_layout_root_raw_switch(self, context)
      _ => CrossStreamLayoutValue::Absent
    }
    1 => match name {
      "root_marker" => instance_cross_stream_layout_type_slot_root_marker(self, context)
      "parent_marker" => instance_cross_stream_layout_type_slot_parent_marker(self, context)
      _ => CrossStreamLayoutValue::Absent
    }
    2 => match name {
      "parent_marker" => instance_cross_stream_layout_type_pair_parent_marker(self, context)
      _ => CrossStreamLayoutValue::Absent
    }
    _ => CrossStreamLayoutValue::Absent
  }
}

///|
fn hydrate_CrossStreamLayout_pair(arena : CrossStreamLayoutArena, context : Int, path : String) -> CrossStreamLayout_pair raise CrossStreamLayoutParseError {
  let frame = arena.frame(context, path)
  guard frame.tag == 2 else { raise CrossStreamLayoutContextError(field=path, offset=frame.reader.offset, message="record context type does not match") }
  {
    first: (match frame.fields.get("first").unwrap_or(CrossStreamLayoutValue::Absent) { CrossStreamLayoutValue::Number(value) => value.to_int().reinterpret_as_uint(); _ => { raise CrossStreamLayoutContextError(field=path, offset=frame.reader.offset, message="value is unavailable or has the wrong type") } }),
    second: (match frame.fields.get("second").unwrap_or(CrossStreamLayoutValue::Absent) { CrossStreamLayoutValue::Number(value) => value.to_int().reinterpret_as_uint(); _ => { raise CrossStreamLayoutContextError(field=path, offset=frame.reader.offset, message="value is unavailable or has the wrong type") } }),
    _ksy_context: context,
    _ksy_arena: arena,
    _ksy_cache_parent_marker: None,
  }
}

///|
pub fn parse_cross_stream_layout(input : Bytes) -> CrossStreamLayoutRecord raise CrossStreamLayoutParseError {
  let arena : CrossStreamLayoutArena = { frames: [], free: [], next_account: 1 }
  let reader : CrossStreamLayoutReader = { input, offset: 0, budget: [1_000_000, 3, 0, 0] }
  read_cross_stream_layout_root(reader, "cross_stream_layout", arena, -1)
}
