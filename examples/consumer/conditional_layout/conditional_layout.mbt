pub fn ConditionalLayoutRecord::boolean_dependency(self : ConditionalLayoutRecord) -> Bool raise ConditionalLayoutParseError {
  if self._ksy_cache_boolean_dependency is Some(value) { return value }
  let reader = self._ksy_reader
  let field = self._ksy_path + ".boolean_dependency"
  guard !self._ksy_busy_boolean_dependency else { raise ConditionalLayoutInstanceCycle(field~, offset=reader.offset) }
  self._ksy_busy_boolean_dependency = true
  defer { self._ksy_busy_boolean_dependency = false }
  let value = {
    let result = (self.has_payload() && true)
    result
  }
  self._ksy_cache_boolean_dependency = Some(value)
  value
}

///|
pub fn ConditionalLayoutRecord::bits(self : ConditionalLayoutRecord) -> Int64 raise ConditionalLayoutParseError {
  if self._ksy_cache_bits is Some(value) { return value }
  let reader = self._ksy_reader
  let field = self._ksy_path + ".bits"
  guard !self._ksy_busy_bits else { raise ConditionalLayoutInstanceCycle(field~, offset=reader.offset) }
  self._ksy_busy_bits = true
  defer { self._ksy_busy_bits = false }
  let value = {
    let result = (reader.arithmetic("<<", 1L, 8L, field) | 2L)
    result
  }
  self._ksy_cache_bits = Some(value)
  value
}

///|
pub fn ConditionalLayoutRecord::loop_a(self : ConditionalLayoutRecord) -> UInt raise ConditionalLayoutParseError {
  if self._ksy_cache_loop_a is Some(value) { return value }
  let reader = self._ksy_reader
  let field = self._ksy_path + ".loop_a"
  guard !self._ksy_busy_loop_a else { raise ConditionalLayoutInstanceCycle(field~, offset=reader.offset) }
  self._ksy_busy_loop_a = true
  defer { self._ksy_busy_loop_a = false }
  let saved = reader.offset
  defer { reader.offset = saved }
  let saved_repeats = reader.repeats_left
  errdefer { reader.repeats_left = saved_repeats }
  let value = {
    reader.seek(self.loop_b().to_int64(), field)
    let result = reader.read_bits(1, false, field)
    result
  }
  self._ksy_cache_loop_a = Some(value)
  value
}

///|
pub fn ConditionalLayoutRecord::loop_b(self : ConditionalLayoutRecord) -> UInt raise ConditionalLayoutParseError {
  if self._ksy_cache_loop_b is Some(value) { return value }
  let reader = self._ksy_reader
  let field = self._ksy_path + ".loop_b"
  guard !self._ksy_busy_loop_b else { raise ConditionalLayoutInstanceCycle(field~, offset=reader.offset) }
  self._ksy_busy_loop_b = true
  defer { self._ksy_busy_loop_b = false }
  let saved = reader.offset
  defer { reader.offset = saved }
  let saved_repeats = reader.repeats_left
  errdefer { reader.repeats_left = saved_repeats }
  let value = {
    reader.seek(self.loop_a().to_int64(), field)
    let result = reader.read_bits(1, false, field)
    result
  }
  self._ksy_cache_loop_b = Some(value)
  value
}

///|
pub fn parse_conditional_layout(input : Bytes) -> ConditionalLayoutRecord raise ConditionalLayoutParseError {
  let reader : ConditionalLayoutReader = { input, offset: 0, repeats_left: 1_000_000 }
  read_conditional_layout_root(reader, "conditional_layout")
}
