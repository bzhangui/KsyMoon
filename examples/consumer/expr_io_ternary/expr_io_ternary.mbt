    two: (match frame.fields.get("two").unwrap_or(ExprIoTernaryValue::Absent) { ExprIoTernaryValue::Number(value) => value.to_int().reinterpret_as_uint(); _ => { raise ExprIoTernaryContextError(field=path, offset=frame.reader.offset, message="value is unavailable or has the wrong type") } }),
    _ksy_context: context,
  }
}

///|
pub fn parse_expr_io_ternary(input : Bytes) -> ExprIoTernaryRecord raise ExprIoTernaryParseError {
  let arena : ExprIoTernaryArena = { frames: [], free: [] }
  let reader : ExprIoTernaryReader = { input, offset: 0 }
  read_expr_io_ternary_root(reader, "expr_io_ternary", arena, -1)
}
